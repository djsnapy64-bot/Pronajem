# ==========================================
# Google Gemini API
# Získejte zdarma na: https://aistudio.google.com/
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ==========================================
# ntfy Notifikace (pro iOS / Android / Web)
# V iOS aplikaci ntfy stačí kliknout na '+' a přihlásit odběr k tomuto tématu
# ==========================================
# Zvolte si unikátní název tématu (např. ostrava-byty-vasejmeno-789)
NTFY_TOPIC=ostrava-byty-sledovani-moap-poruba
NTFY_SERVER_URL=https://ntfy.sh

# Volitelný přístupový token (pouze pokud používáte chráněné téma na ntfy.sh nebo vlastní server)
NTFY_ACCESS_TOKEN=

# ==========================================
# Filtry nabídek
# ==========================================
# Povolené dispozice oddělené čárkou (prázdné = všechny)
FILTER_ALLOWED_DISPOSITIONS=2+1,2+kk,3+1,3+kk,4+1,4+kk

# Maximální čisté nájemné v Kč/měsíc (0 = bez omezení)
FILTER_MAX_RENT=15000

# Minimální podlahová plocha v m2 (0 = bez omezení)
FILTER_MIN_AREA_M2=40

# ==========================================
# Nastavení scraperu a databáze
# ==========================================
# Sledované obvody: moap, poruba (oddělené čárkou)
SCRAPE_DISTRICTS=moap,poruba

# Cesta k SQLite databázi pro deduplikaci
DB_PATH=seen_items.db
