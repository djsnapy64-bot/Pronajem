# ==========================================
# Google Gemini API
# Získejte zdarma na: https://aistudio.google.com/
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ==========================================
# Telegram Notifikace
# Vytvořte bota přes @BotFather a získejte chat ID přes @userinfobot
# ==========================================
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=123456789

# ==========================================
# Filtry nabídek
# ==========================================
# Povolené dispozice oddělené čárkou (prázdné = všechny)
FILTER_ALLOWED_DISPOSITIONS=2+1,2+kk,3+1,3+kk,4+1,4+kk

# Maximální čisté nájemné v Kč/měsíc (0 = bez omezení)
FILTER_MAX_RENT=15000

# Minimální podlahová plocha v m2 (0 = bez omezení)
FILTER_MIN_AREA_M2=40

# ==========================================
# Nastavení scraperu a databáze
# ==========================================
# Sledované obvody: moap, poruba (oddělené čárkou)
SCRAPE_DISTRICTS=moap,poruba

# Cesta k SQLite databázi pro deduplikaci
DB_PATH=seen_items.db
